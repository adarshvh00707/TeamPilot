# Backend configuration (API + worker). Copy to .env for local development. Never commit real values.

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
PORT=4000
# Direct Postgres connection used by the API/worker (local Supabase CLI default shown).
# Production: use the Supabase pooler connection string and set DATABASE_SSL=true.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Supabase project URL; access tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54321
# Optional: legacy HS256 JWT secret (local CLI / projects not yet on asymmetric signing keys).
SUPABASE_JWT_SECRET=
# Comma-separated browser origins allowed by CORS (native apps send no Origin header).
CORS_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=300
INVITATION_TTL_HOURS=168

# --- Worker ---
REDIS_URL=redis://127.0.0.1:6379
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=4100

# --- Integrations (not yet implemented; listed so environments can be prepared) ---
