# Copy to apps/mobile/.env.local. These are bundled into the app and must never contain secrets.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Use your computer's LAN IP (not 127.0.0.1) when testing on a physical device or Android emulator.
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
